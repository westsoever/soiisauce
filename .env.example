# .env.example — copy to .env.local for local dev.

# --- Vault ---
# The vault folder on disk. soii reads it, and writes to it (Add, Log, property edits, views) as local git commits.
VAULT_PATH=

# --- Local dev only ---
# Dev server port (default 13390; leave empty to use it).
PORT=

# --- soii installed in a vault (`soii install`) ---
# That service is started with SOII_LOCAL=1 (port 5011, 127.0.0.1 only) by `soii run`; don't set it by hand.
# Its keys go in <vault>/.soii/.env.local (GOOGLE_BOOKS_API_KEY, TMDB_API_KEY), then `soii restart`.
# `soii run` also sets SOII_VERSION (the release it is running) so the app can tell when a newer one exists; don't set it by hand.
# SOII_LOCAL_FORCE=1 switches off the loopback-only guards. Unsafe: soii has no sign-in, so only for a network you control.

# Library covers (optional but recommended). Google's shared keyless quota runs out
# quickly; a key (Google Cloud → APIs → Books API) keeps book covers working.
GOOGLE_BOOKS_API_KEY=

# Movie & documentary posters (optional). Without it they show a title tile.
# themoviedb.org → Settings → API: either the v3 API key or the v4 read token works.
TMDB_API_KEY=
