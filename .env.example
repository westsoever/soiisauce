# .env.example — copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# --- Vault source (build time) ---
# Local dev: point at a vault folder on disk. Not used on Vercel.
VAULT_PATH=
# Deploys: owner/name of the vault repo on GitHub…
VAULT_REPO=
# …and a fine-grained personal access token with read-only "Contents" on that one repo.
VAULT_TOKEN=
# Branch to build from, and to commit new notes to (default: main).
VAULT_REF=main
# Optional, for "Add to vault" in the Library: a SECOND fine-grained token on the same repo with
# Contents: read AND write. Used at runtime only, never for the build. Keep VAULT_TOKEN read-only.
# Without it, notes are written to VAULT_PATH on disk in local dev; on Vercel the Add button only copies/downloads.
VAULT_WRITE_TOKEN=
# Optional: a full git URL instead of VAULT_REPO (GitLab, self-hosted…). Credentials in the URL are never logged.
VAULT_GIT_URL=

# --- Sign-in (runtime) ---
# GitHub OAuth App: callback URL https://<your-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign in.
SOII_ALLOWED_GITHUB_LOGINS=
# At least 32 random characters: `openssl rand -base64 48`
SOII_SESSION_SECRET=

# --- Local dev only ---
# 1 = skip sign-in (ignored on Vercel).
SOII_DEV_AUTH=
# Dev server port (default 13390; leave empty to use it).
PORT=

# --- soii installed in a vault (`soii install`) ---
# That service is started with SOII_LOCAL=1 (no sign-in, port 5011, 127.0.0.1 only) by `soii run`; don't set it by hand.
# Its keys go in <vault>/.soii/.env.local (GOOGLE_BOOKS_API_KEY, TMDB_API_KEY), then `soii restart`.
# `soii run` also sets SOII_VERSION (the release it is running) so the app can tell when a newer one exists; don't set it by hand.
# SOII_LOCAL_FORCE=1 switches off the loopback-only guards. Unsafe: only for a network you control.

# Library covers (optional but recommended). Google's shared keyless quota runs out
# quickly; a key (Google Cloud → APIs → Books API) keeps book covers working.
GOOGLE_BOOKS_API_KEY=

# Movie & documentary posters (optional). Without it they show a title tile.
# themoviedb.org → Settings → API: either the v3 API key or the v4 read token works.
TMDB_API_KEY=
