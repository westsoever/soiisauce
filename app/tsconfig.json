{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["bun"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../scripts/**/*.ts"],
  "exclude": ["./.generated/**", "./vault/__fixtures__/**", "../scripts/readme-screenshots.ts"]
}
